<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_background">

    <!-- MAIN CONTAINER -->
    <LinearLayout
        android:id="@+id/mainContentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/light_background">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/light_surface"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:elevation="2dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/light_text_primary"
                android:contentDescription="Navigation Menu" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/app_icon"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GSM SIM Gateway"
                android:textColor="@color/light_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="10dp" />

            <ImageButton
                android:id="@+id/btnThemeToggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_day"
                android:tint="@color/light_text_secondary"
                android:layout_marginEnd="6dp"
                android:contentDescription="Toggle Theme" />

            <TextView
                android:id="@+id/tvHeaderConnection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 OFFLINE"
                android:textColor="@color/status_offline"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="@color/light_surface_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Scrollable Body Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ==================== TAB 0: GSM GATEWAY VIEW ==================== -->
                <LinearLayout
                    android:id="@+id/layoutGatewayView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Quick Permissions Summary Banner -->
                    <LinearLayout
                        android:id="@+id/bannerPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_surface"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp"
                        android:elevation="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvPermissionBannerTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Permissions Status"
                                android:textColor="@color/light_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPermissionBannerDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Microphone &amp; Phone permissions verified."
                                android:textColor="@color/light_text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnViewPermissionsAudit"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:backgroundTint="@color/light_surface_selected"
                            android:text="Audit"
                            android:textColor="@color/primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Gateway Server Connection Card -->
                    <LinearLayout
                        android:id="@+id/cardConnection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_surface"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="GATEWAY SERVER BRIDGE"
                                android:textColor="@color/light_text_muted"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvConnectionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔴 OFFLINE"
                                android:textColor="@color/status_offline"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatusDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready to route physical GSM calls to Nexus AI."
                            android:textColor="@color/light_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <!-- Latency & Codec Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Measured RTT: "
                                android:textColor="@color/light_text_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvLatency"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="—"
                                android:textColor="@color/accent"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Codec: 16kHz PCM"
                                android:textColor="@color/light_text_muted"
                                android:textSize="10sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <!-- Server IP Input -->
                        <EditText
                            android:id="@+id/tvServerIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/light_surface_card"
                            android:hint="wss://.../api/android-gateway/ws/bridge"
                            android:textColor="@color/light_text_primary"
                            android:textColorHint="@color/light_text_muted"
                            android:padding="10dp"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <!-- Fast Presets Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical">

                            <Button
                                android:id="@+id/btnPresetTunnel"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/light_surface_card"
                                android:text="☁️ Secure Tunnel"
                                android:textColor="@color/accent"
                                android:textSize="10sp"
                                android:layout_marginEnd="4dp" />

                            <Button
                                android:id="@+id/btnPresetLan"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/light_surface_card"
                                android:text="📶 Wi-Fi LAN"
                                android:textColor="@color/light_text_primary"
                                android:textSize="10sp"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <!-- Primary Connect Button -->
                        <Button
                            android:id="@+id/btnConnect"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="@color/primary"
                            android:text="Connect Gateway to Server"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Auto-Answer & Call Delay Configuration Card (NEW) -->
                    <LinearLayout
                        android:id="@+id/cardAutoAnswerSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_surface"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="AUTOMATIC CALL ANSWERING"
                                    android:textColor="@color/light_text_muted"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Auto-pick incoming GSM calls and connect to AI"
                                    android:textColor="@color/light_text_secondary"
                                    android:textSize="11sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <Switch
                                android:id="@+id/switchAutoAnswer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>

                        <!-- Delay Selection Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pick-up Delay Before Answering:"
                            android:textColor="@color/light_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="6dp" />

                        <!-- Delay Selection Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnDelay0"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/light_surface_card"
                                android:text="⚡ 0s"
                                android:textColor="@color/light_text_primary"
                                android:textSize="10sp"
                                android:layout_marginEnd="2dp" />

                            <Button
                                android:id="@+id/btnDelay3"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/primary"
                                android:text="⏱️ 3s"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:layout_marginHorizontal="2dp" />

                            <Button
                                android:id="@+id/btnDelay5"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/light_surface_card"
                                android:text="⏱️ 5s"
                                android:textColor="@color/light_text_primary"
                                android:textSize="10sp"
                                android:layout_marginHorizontal="2dp" />

                            <Button
                                android:id="@+id/btnDelay10"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/light_surface_card"
                                android:text="⏱️ 10s"
                                android:textColor="@color/light_text_primary"
                                android:textSize="10sp"
                                android:layout_marginStart="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Real Device Hardware Card -->
                    <LinearLayout
                        android:id="@+id/cardDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_surface"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp"
                        android:elevation="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEVICE HARDWARE IDENTITY"
                            android:textColor="@color/light_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Device Model"
                                android:textColor="@color/light_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDeviceModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading..."
                                android:textColor="@color/light_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Android Version"
                                android:textColor="@color/light_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvAndroidVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading..."
                                android:textColor="@color/light_text_primary"
                                android:textSize="12sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Battery Level"
                                android:textColor="@color/light_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvBattery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading..."
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Network / Modem"
                                android:textColor="@color/light_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvNetworkSignal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading..."
                                android:textColor="@color/accent"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- SIM / Subscriptions Card -->
                    <LinearLayout
                        android:id="@+id/cardSim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/light_surface"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="14dp"
                        android:elevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SIM / CELLULAR SUBSCRIPTIONS"
                                android:textColor="@color/light_text_muted"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvSimCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 SIMs"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llSimCardsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNoSimMsg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="No active SIM detected or permissions needed."
                                android:textColor="@color/light_text_secondary"
                                android:textSize="12sp"
                                android:paddingVertical="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ==================== TAB 1: PERMISSIONS AUDIT VIEW ==================== -->
                <LinearLayout
                    android:id="@+id/layoutPermissionsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Permissions Audit"
                        android:textColor="@color/light_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete status of all hardware, telephony and audio permissions."
                        android:textColor="@color/light_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/llPermissionsListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Permissions Actions Row -->
                    <Button
                        android:id="@+id/btnGrantAllPermissionsDetailed"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/primary"
                        android:text="Grant Missing Permissions"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnOpenSettingsDirect"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/light_surface_card"
                        android:text="⚙️ Open App System Settings"
                        android:textColor="@color/light_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ==================== TAB 2: AI VOICE AGENTS VIEW ==================== -->
                <LinearLayout
                    android:id="@+id/layoutAgentsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nexus AI Voice Agents"
                        android:textColor="@color/light_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live conversational agents active on your Nexus Call OS server."
                        android:textColor="@color/light_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/llAgentsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- ==================== TAB 3: VOICE & LANGUAGE STUDIO VIEW ==================== -->
                <LinearLayout
                    android:id="@+id/layoutVoicesView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice Engines &amp; Multilingual STT/TTS"
                        android:textColor="@color/light_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time speech synthesis, streaming transcription and regional dialects."
                        android:textColor="@color/light_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/llVoicesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- ==================== TAB 4: SYSTEM DIAGNOSTICS VIEW ==================== -->
                <LinearLayout
                    android:id="@+id/layoutDiagnosticsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware &amp; Bridge Diagnostics"
                        android:textColor="@color/light_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time telemetry, network latency and background service health."
                        android:textColor="@color/light_text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/llDiagnosticsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- SIDEBAR NAVIGATION DRAWER -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/light_surface"
        android:orientation="vertical"
        android:padding="20dp"
        android:elevation="16dp">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/app_icon"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nexus Call OS"
                    android:textColor="@color/light_text_primary"
